{
  "name": "surface-roughness-average",
  "productName": "Surface Roughness Average",
  "version": "2.0.0",
  "description": "Extracts and averages Ra, Rz, and Rmr",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "make": "electron-forge make"
  },
  "author": "Proteor",
  "license": "ISC",
  "devDependencies": {
    "@electron-forge/cli": "^7.2.0",
    "@electron-forge/maker-deb": "^7.2.0",
    "@electron-forge/maker-rpm": "^7.2.0",
    "@electron-forge/maker-squirrel": "^7.2.0",
    "@electron-forge/maker-zip": "^7.2.0",
    "electron": "^28.0.0"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.0"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "Surface Roughness Average",
        "icon": "./icon"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "SurfaceRoughnessAverage",
            "setupIcon": "./icon.ico",
            "setupExe": "SurfaceRoughnessAverage.exe",
            "iconUrl": "https://raw.githubusercontent.com/webdev-jason/1019-data-extractor/main/icon.ico",
            "loadingGif": ""
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        }
      ]
    }
  }
}